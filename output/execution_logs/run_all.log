SQL> -- -----------------------------------------------------------------------------
SQL> -- 2. CURSOR FOR LOOP
SQL> -- Scenario: Daily Sales Reconciliation. Iterates through completed transactions,
SQL> -- 	  aggregating total revenue and cashier performance.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 2. CURSOR FOR LOOP: Daily Sales Reconciliation & Tender Summary ===
=== 2. CURSOR FOR LOOP: Daily Sales Reconciliation & Tender Summary ===
SQL> DECLARE
  2  	 v_grand_total NUMBER(12,2) := 0;
  3  	 v_order_count NUMBER := 0;
  4  BEGIN
  5  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
  6  	 DBMS_OUTPUT.PUT_LINE('CURSOR FOR LOOP: SALES RECONCILIATION');
  7  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
  8  	 DBMS_OUTPUT.PUT_LINE(RPAD('RECEIPT NO', 16) || RPAD('CUSTOMER', 20) || RPAD('CASHIER', 18) ||
  9  			      LPAD('TOTAL (INR)', 14));
 10  	 DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 11  
 12  	 -- Cursor FOR loop automatically handles OPEN, FETCH, and CLOSE
 13  	 FOR sale_rec IN (
 14  	     SELECT
 15  		 st.receipt_number,
 16  		 NVL(c.first_name || ' ' || c.last_name, 'Guest Customer') AS customer_name,
 17  		 e.full_name AS cashier_name,
 18  		 st.total_amount
 19  	     FROM SalesTransaction st
 20  	     LEFT JOIN Customer c ON st.customer_id = c.customer_id
 21  	     INNER JOIN Employee e ON st.cashier_id = e.employee_id
 22  	     WHERE st.status = 'COMPLETED'
 23  	     ORDER BY st.transaction_id
 24  	 ) LOOP
 25  	     v_order_count := v_order_count + 1;
 26  	     v_grand_total := v_grand_total + sale_rec.total_amount;
 27  
 28  	     DBMS_OUTPUT.PUT_LINE(RPAD(sale_rec.receipt_number, 16) ||
 29  				  RPAD(SUBSTR(sale_rec.customer_name, 1, 18), 20) ||
 30  				  RPAD(SUBSTR(sale_rec.cashier_name, 1, 16), 18) ||
 31  				  LPAD(TO_CHAR(sale_rec.total_amount, '999,990.00'), 14));
 32  	 END LOOP;
 33  
 34  	 DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 35  	 DBMS_OUTPUT.PUT_LINE('Total Completed Sales: ' || v_order_count ||
 36  			      ' | Grand Total Settled: INR ' || TO_CHAR(v_grand_total, '999,990.00'));
 37  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
 38  END;
 39  /
