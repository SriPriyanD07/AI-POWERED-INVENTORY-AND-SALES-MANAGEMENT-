SQL> -- 3. FUNCTION: CALCULATE_LOYALTY_POINTS (OPTIONAL / DEMONSTRATION ONLY)
SQL> -- Status: OPTIONAL / DEMONSTRATION ONLY — NOT AN APPROVED CORE BUSINESS RULE
SQL> -- Note: The SmartRetail DA2 handoff brief does NOT prescribe an approved loyalty
SQL> --       calculation rule. As instructed by Section 6 of the handoff brief, this
SQL> --       function is provided strictly as an optional academic PL/SQL demonstration
SQL> --       of function syntax, return types, and conditional logic. It must NOT be
SQL> --       treated as a canonical SmartRetail business rule.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE FUNCTION CALCULATE_LOYALTY_POINTS (
  2  	 p_amount IN NUMBER
  3  ) RETURN NUMBER IS
  4  BEGIN
  5  	 IF p_amount IS NULL OR p_amount <= 0 THEN
  6  	     RETURN 0;
  7  	 END IF;
  8  
  9  	 -- Arbitrary academic demo ratio (1 pt per 10 currency units) - Demonstration Only
 10  	 RETURN FLOOR(p_amount / 10);
 11  END CALCULATE_LOYALTY_POINTS;
 12  /

