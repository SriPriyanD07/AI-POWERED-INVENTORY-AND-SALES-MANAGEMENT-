SQL> -- 1. VIEW: vw_low_stock
SQL> -- Description: Identifies any storage location where live stock is at or below
SQL> -- 	     the defined reorder threshold, indicating immediate action needed.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Creating VIEW: vw_low_stock ===
=== Creating VIEW: vw_low_stock ===
SQL> CREATE OR REPLACE VIEW vw_low_stock AS
  2  SELECT
  3  	 loc.location_id,
  4  	 loc.location_code,
  5  	 loc.location_type,
  6  	 loc.location_name,
  7  	 p.product_id,
  8  	 p.sku,
  9  	 p.product_name,
 10  	 stk.quantity_on_hand,
 11  	 stk.reorder_threshold,
 12  	 stk.reorder_quantity,
 13  	 (stk.reorder_threshold - stk.quantity_on_hand) AS deficit_quantity,
 14  	 stk.last_updated_at
 15  FROM InventoryStock stk
 16  INNER JOIN InventoryLocation loc ON stk.location_id = loc.location_id
 17  INNER JOIN Product p	      ON stk.product_id = p.product_id
 18  WHERE stk.quantity_on_hand <= stk.reorder_threshold;

