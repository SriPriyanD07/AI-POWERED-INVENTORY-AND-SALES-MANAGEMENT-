SQL> -- -----------------------------------------------------------------------------
SQL> -- 1. FUNCTION: CALCULATE_SALE_TOTAL
SQL> -- Description: Computes total monetary value of lines for a given SalesTransaction.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE FUNCTION CALCULATE_SALE_TOTAL (
  2  	 p_transaction_id IN NUMBER
  3  ) RETURN NUMBER IS
  4  	 v_total NUMBER(10,2);
  5  BEGIN
  6  	 SELECT NVL(SUM(quantity_sold * unit_price), 0)
  7  	 INTO v_total
  8  	 FROM SalesTransactionLine
  9  	 WHERE transaction_id = p_transaction_id;
 10  
 11  	 RETURN v_total;
 12  EXCEPTION
 13  	 WHEN OTHERS THEN
 14  	     RETURN 0;
 15  END CALCULATE_SALE_TOTAL;
 16  /

Function created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 2. FUNCTION: CALCULATE_STOCK_VALUE
SQL> -- Description: Computes live inventory asset valuation (QOH × standard_unit_price).
SQL> -- 	     Filters by location if p_location_id is supplied; otherwise aggregates
SQL> -- 	     across the entire enterprise.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE FUNCTION CALCULATE_STOCK_VALUE (
  2  	 p_product_id  IN NUMBER,
  3  	 p_location_id IN NUMBER DEFAULT NULL
  4  ) RETURN NUMBER IS
  5  	 v_unit_price NUMBER(10,2);
  6  	 v_total_qoh  NUMBER(8);
  7  	 v_valuation  NUMBER(12,2);
  8  BEGIN
  9  	 -- 1. Get standard unit price of product
 10  	 SELECT standard_unit_price
 11  	 INTO v_unit_price
 12  	 FROM Product
 13  	 WHERE product_id = p_product_id;
 14  
 15  	 -- 2. Sum QOH based on location filter
 16  	 IF p_location_id IS NOT NULL THEN
 17  	     SELECT NVL(SUM(quantity_on_hand), 0)
 18  	     INTO v_total_qoh
 19  	     FROM InventoryStock
 20  	     WHERE product_id = p_product_id
 21  	       AND location_id = p_location_id;
 22  	 ELSE
 23  	     SELECT NVL(SUM(quantity_on_hand), 0)
 24  	     INTO v_total_qoh
 25  	     FROM InventoryStock
 26  	     WHERE product_id = p_product_id;
 27  	 END IF;
 28  
 29  	 v_valuation := ROUND(v_total_qoh * v_unit_price, 2);
 30  	 RETURN v_valuation;
 31  EXCEPTION
 32  	 WHEN NO_DATA_FOUND THEN
 33  	     RETURN 0;
 34  	 WHEN OTHERS THEN
 35  	     RETURN 0;
 36  END CALCULATE_STOCK_VALUE;
 37  /

Function created.

