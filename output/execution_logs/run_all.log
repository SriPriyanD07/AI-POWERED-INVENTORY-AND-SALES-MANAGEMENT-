SQL> -- SCENARIO 3: SAVEPOINT & ROLLBACK TO SAVEPOINT
SQL> -- Description: Multi-item basket checkout where customer cancels one item at checkout.
SQL> -- Steps:
SQL> --   1. Add Item A (Real Mixed Juice, Product 7) -> SAVEPOINT sp_after_item_a
SQL> --   2. Add Item B (Tata Tea, Product 9)	     -> SAVEPOINT sp_after_item_b
SQL> --   3. Customer decides not to purchase Item B -> ROLLBACK TO SAVEPOINT sp_after_item_a
SQL> --   4. Complete and COMMIT checkout with Item A only.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Scenario 3: SAVEPOINT and Partial Rollback Demonstration ===
=== Scenario 3: SAVEPOINT and Partial Rollback Demonstration ===
SQL> 
SQL> DECLARE
  2  	 v_cart_txn_id NUMBER;
  3  	 v_tea_stock_before NUMBER;
  4  BEGIN
  5  	 SELECT SEQ_SALES_TXN_ID.NEXTVAL INTO v_cart_txn_id FROM dual;
  6  
  7  	 SELECT quantity_on_hand INTO v_tea_stock_before
  8  	 FROM InventoryStock WHERE location_id = 5 AND product_id = 9;
  9  
 10  	 DBMS_OUTPUT.PUT_LINE('Starting POS Basket: Initial Tea QOH = ' || v_tea_stock_before);
 11  
 12  	 -- Header
 13  	 INSERT INTO SalesTransaction (
 14  	     transaction_id, receipt_number, customer_id, cashier_id,
 15  	     transaction_date, total_amount, status
 16  	 ) VALUES (
 17  	     v_cart_txn_id, 'RCP-SAVEPOINT-03', 1, 2,
 18  	     SYSTIMESTAMP, 0.00, 'COMPLETED'
 19  	 );
 20  
 21  	 -- Add Item A: 1 Mixed Fruit Juice @ 120.00
 22  	 INSERT INTO SalesTransactionLine (transaction_id, product_id, shelf_location_id, quantity_sold, unit_price)
 23  	 VALUES (v_cart_txn_id, 7, 5, 1, 120.00);
 24  
 25  	 UPDATE InventoryStock SET quantity_on_hand = quantity_on_hand - 1
 26  	 WHERE location_id = 5 AND product_id = 7;
 27  
 28  	 -- SAVEPOINT 1: Item A securely in basket
 29  	 SAVEPOINT sp_after_item_a;
 30  	 DBMS_OUTPUT.PUT_LINE('Marked SAVEPOINT: sp_after_item_a (Item A added)');
 31  
 32  	 -- Add Item B: 1 Tata Tea Gold @ 320.00
 33  	 INSERT INTO SalesTransactionLine (transaction_id, product_id, shelf_location_id, quantity_sold, unit_price)
 34  	 VALUES (v_cart_txn_id, 9, 5, 1, 320.00);
 35  
 36  	 UPDATE InventoryStock SET quantity_on_hand = quantity_on_hand - 1
 37  	 WHERE location_id = 5 AND product_id = 9;
