 39  	 DBMS_OUTPUT.PUT_LINE('Added Item B (Tea). Temporary Tea QOH decremented.');
 40  
 41  	 -- Customer changes mind and declines Item B
 42  	 DBMS_OUTPUT.PUT_LINE('Customer cancels Item B. Rolling back to SAVEPOINT sp_after_item_a...');
 43  	 ROLLBACK TO SAVEPOINT sp_after_item_a;
 44  
 45  	 -- Update total amount to reflect only Item A
 46  	 UPDATE SalesTransaction SET total_amount = 120.00 WHERE transaction_id = v_cart_txn_id;
 47  
 48  	 -- Record Payment for Item A
 49  	 INSERT INTO Payment (
 50  	     payment_id, transaction_id, payment_method, amount,
 51  	     payment_date, reference_number, status
 52  	 ) VALUES (
 53  	     SEQ_PAYMENT_ID.NEXTVAL, v_cart_txn_id, 'CASH', 120.00,
 54  	     SYSTIMESTAMP, NULL, 'SUCCESS'
 55  	 );
 56  
 57  	 -- Final COMMIT of remaining basket
 58  	 COMMIT;
 59  	 DBMS_OUTPUT.PUT_LINE('--> Partial transaction COMMITTED. Only Item A was finalized.');
 60  END;
