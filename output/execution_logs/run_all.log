SQL> -- 7. COMMON TABLE EXPRESSION (WITH Clause / CTE)
SQL> -- Description: Compute total product sales revenue and units sold, then join
SQL> -- 	     with product details to rank revenue performance.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 7. CTE (WITH Clause): Product Sales Revenue Performance ===
=== 7. CTE (WITH Clause): Product Sales Revenue Performance ===
SQL> WITH ProductSalesSummary AS (
  2  	 SELECT
  3  	     stl.product_id,
  4  	     SUM(stl.quantity_sold) AS total_units_sold,
  5  	     SUM(stl.quantity_sold * stl.unit_price) AS gross_revenue
  6  	 FROM SalesTransactionLine stl
  7  	 INNER JOIN SalesTransaction st ON stl.transaction_id = st.transaction_id
  8  	 WHERE st.status = 'COMPLETED'
  9  	 GROUP BY stl.product_id
 10  )
 11  SELECT
 12  	 p.product_id,
 13  	 p.sku,
 14  	 p.product_name,
 15  	 pss.total_units_sold,
 16  	 pss.gross_revenue,
 17  	 ROUND((pss.gross_revenue / (SELECT SUM(gross_revenue) FROM ProductSalesSummary)) * 100, 2) AS revenue_pct
 18  FROM Product p
 19  INNER JOIN ProductSalesSummary pss ON p.product_id = pss.product_id
 20  ORDER BY pss.gross_revenue DESC;

