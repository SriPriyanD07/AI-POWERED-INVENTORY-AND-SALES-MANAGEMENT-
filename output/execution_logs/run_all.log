SQL> -- 6. CASE EXPRESSION
SQL> -- Description: Evaluate live inventory stock health based on quantity_on_hand
SQL> -- 	     relative to reorder_threshold.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 6. CASE EXPRESSION: Dynamic Stock Health Assessment ===
=== 6. CASE EXPRESSION: Dynamic Stock Health Assessment ===
SQL> SELECT
  2  	 loc.location_code,
  3  	 loc.location_type,
  4  	 p.product_name,
  5  	 stk.quantity_on_hand,
  6  	 stk.reorder_threshold,
  7  	 CASE
  8  	     WHEN stk.quantity_on_hand = 0 THEN 'OUT OF STOCK'
  9  	     WHEN stk.quantity_on_hand <= stk.reorder_threshold THEN 'CRITICAL - REORDER'
 10  	     WHEN stk.quantity_on_hand <= (stk.reorder_threshold * 2) THEN 'LOW - MONITOR'
 11  	     ELSE 'HEALTHY BUFFER'
 12  	 END AS stock_health_status
 13  FROM InventoryStock stk
 14  INNER JOIN Product p	     ON stk.product_id = p.product_id
 15  INNER JOIN InventoryLocation loc ON stk.location_id = loc.location_id
 16  ORDER BY loc.location_type, stk.quantity_on_hand ASC;

