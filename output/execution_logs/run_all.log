SQL> -- 7. GROUP BY and HAVING
SQL> -- Description: Group purchase orders by supplier, calculate order metrics,
SQL> -- 	     and filter only suppliers with cumulative PO value >= 20000.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 6. GROUP BY & HAVING: Suppliers with Total Purchase Orders >= 20,000 ===
=== 6. GROUP BY & HAVING: Suppliers with Total Purchase Orders >= 20,000 ===
SQL> SELECT
  2  	 s.supplier_id,
  3  	 s.supplier_name,
  4  	 COUNT(po.po_id)	     AS total_pos_issued,
  5  	 SUM(po.total_amount)	     AS gross_po_value,
  6  	 ROUND(AVG(po.total_amount), 2) AS avg_po_value
  7  FROM Supplier s
  8  INNER JOIN PurchaseOrder po ON s.supplier_id = po.supplier_id
  9  GROUP BY s.supplier_id, s.supplier_name
 10  HAVING SUM(po.total_amount) >= 20000.00
 11  ORDER BY gross_po_value DESC;

