SQL> -- -----------------------------------------------------------------------------
SQL> -- 1. EXPLICIT CURSOR (OPEN, FETCH, %NOTFOUND, CLOSE)
SQL> -- Scenario: Inventory Stock Auditor. Iterates through stock levels across all
SQL> -- 	  locations and flags low-stock conditions requiring reorder.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 1. EXPLICIT CURSOR: Inventory Stock Audit and Low Stock Identifier ===
=== 1. EXPLICIT CURSOR: Inventory Stock Audit and Low Stock Identifier ===
SQL> DECLARE
  2  	 -- Explicit Cursor Declaration
  3  	 CURSOR cur_stock_audit IS
  4  	     SELECT
  5  		 loc.location_code,
  6  		 loc.location_type,
  7  		 p.sku,
  8  		 p.product_name,
  9  		 stk.quantity_on_hand,
 10  		 stk.reorder_threshold
 11  	     FROM InventoryStock stk
 12  	     INNER JOIN InventoryLocation loc ON stk.location_id = loc.location_id
 13  	     INNER JOIN Product p	      ON stk.product_id = p.product_id
 14  	     ORDER BY loc.location_type, p.sku;
 15  
 16  	 -- Record variable using %ROWTYPE
 17  	 v_rec cur_stock_audit%ROWTYPE;
 18  	 v_total_reviewed NUMBER := 0;
 19  	 v_low_count	  NUMBER := 0;
 20  BEGIN
 21  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
 22  	 DBMS_OUTPUT.PUT_LINE('EXPLICIT CURSOR INVENTORY AUDIT REPORT');
 23  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
 24  	 DBMS_OUTPUT.PUT_LINE(RPAD('LOC CODE', 15) || RPAD('SKU', 14) || RPAD('PRODUCT NAME', 28) ||
 25  			      LPAD('QOH', 6) || LPAD('THRESH', 8) || '	' || 'STATUS');
 26  	 DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 27  
 28  	 -- Explicit OPEN
 29  	 OPEN cur_stock_audit;
 30  
 31  	 LOOP
 32  	     -- Explicit FETCH
 33  	     FETCH cur_stock_audit INTO v_rec;
 34  	     EXIT WHEN cur_stock_audit%NOTFOUND;
 35  
 36  	     v_total_reviewed := v_total_reviewed + 1;
 37  
 38  	     IF v_rec.quantity_on_hand <= v_rec.reorder_threshold THEN
 39  		 v_low_count := v_low_count + 1;
 40  		 DBMS_OUTPUT.PUT_LINE(RPAD(v_rec.location_code, 15) ||
 41  				      RPAD(v_rec.sku, 14) ||
 42  				      RPAD(SUBSTR(v_rec.product_name, 1, 26), 28) ||
 43  				      LPAD(v_rec.quantity_on_hand, 6) ||
 44  				      LPAD(v_rec.reorder_threshold, 8) || '  ' || '[**REORDER ALERT**]');
 45  	     ELSE
 46  		 DBMS_OUTPUT.PUT_LINE(RPAD(v_rec.location_code, 15) ||
 47  				      RPAD(v_rec.sku, 14) ||
 48  				      RPAD(SUBSTR(v_rec.product_name, 1, 26), 28) ||
 49  				      LPAD(v_rec.quantity_on_hand, 6) ||
 50  				      LPAD(v_rec.reorder_threshold, 8) || '  ' || 'OK');
 51  	     END IF;
 52  	 END LOOP;
 53  
 54  	 -- Explicit CLOSE
 55  	 CLOSE cur_stock_audit;
 56  
 57  	 DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 58  	 DBMS_OUTPUT.PUT_LINE('Summary: ' || v_total_reviewed || ' stock records audited. ' ||
 59  			      v_low_count || ' locations require replenishment.');
 60  	 DBMS_OUTPUT.PUT_LINE('======================================================================');
 61  END;
 62  /
======================================================================                                                  
EXPLICIT CURSOR INVENTORY AUDIT REPORT                                                                                  
======================================================================                                                  
