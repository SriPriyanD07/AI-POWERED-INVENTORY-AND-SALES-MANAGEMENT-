SQL> -- -----------------------------------------------------------------------------
SQL> -- 3. PARAMETERIZED CURSOR
SQL> -- Scenario: Category Inspector. Takes a category_id parameter, fetches all
SQL> -- 	  products within that category, and displays price & active status.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 3. PARAMETERIZED CURSOR: Category Product Inspector ===
=== 3. PARAMETERIZED CURSOR: Category Product Inspector ===
SQL> DECLARE
  2  	 -- Parameterized Cursor Declaration
  3  	 CURSOR cur_category_products (p_cat_id NUMBER) IS
  4  	     SELECT
  5  		 p.product_id,
  6  		 p.sku,
  7  		 p.product_name,
  8  		 p.unit_of_measure,
  9  		 p.standard_unit_price,
 10  		 p.is_active
 11  	     FROM Product p
 12  	     WHERE p.category_id = p_cat_id
 13  	     ORDER BY p.standard_unit_price DESC;
 14  
 15  	 v_cat_name VARCHAR2(100);
 16  
 17  	 PROCEDURE inspect_category(p_cid NUMBER) IS
 18  	     v_prod_count NUMBER := 0;
 19  	 BEGIN
 20  	     SELECT category_name INTO v_cat_name
 21  	     FROM ProductCategory
 22  	     WHERE category_id = p_cid;
 23  
 24  	     DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 25  	     DBMS_OUTPUT.PUT_LINE('CATEGORY REPORT FOR: [' || p_cid || '] ' || UPPER(v_cat_name));
 26  	     DBMS_OUTPUT.PUT_LINE('----------------------------------------------------------------------');
 27  	     DBMS_OUTPUT.PUT_LINE(RPAD('SKU', 14) || RPAD('PRODUCT NAME', 32) || RPAD('UOM', 10) ||
 28  				  LPAD('PRICE', 10) || '  ' || 'ACTIVE');
 29  
 30  	     -- Open parameterized cursor with specific argument
 31  	     FOR p_rec IN cur_category_products(p_cid) LOOP
 32  		 v_prod_count := v_prod_count + 1;
 33  		 DBMS_OUTPUT.PUT_LINE(RPAD(p_rec.sku, 14) ||
 34  				      RPAD(SUBSTR(p_rec.product_name, 1, 30), 32) ||
 35  				      RPAD(p_rec.unit_of_measure, 10) ||
 36  				      LPAD(TO_CHAR(p_rec.standard_unit_price, '990.00'), 10) || '  ' ||
 37  				      p_rec.is_active);
 38  	     END LOOP;
 39  
 40  	     IF v_prod_count = 0 THEN
 41  		 DBMS_OUTPUT.PUT_LINE('  (No products assigned to this category)');
 42  	     END IF;
 43  	 END;
 44  BEGIN
