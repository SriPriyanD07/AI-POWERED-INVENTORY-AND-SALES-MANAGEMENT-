SQL> -- 3. VIEW: vw_monthly_sales
SQL> -- Description: Aggregates sales volume, customer footfall, gross receipts, and
SQL> -- 	     average basket size broken down by sales period (Year-Month).
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Creating VIEW: vw_monthly_sales ===
=== Creating VIEW: vw_monthly_sales ===
SQL> CREATE OR REPLACE VIEW vw_monthly_sales AS
  2  SELECT
  3  	 TO_CHAR(transaction_date, 'YYYY-MM')	AS sales_month,
  4  	 COUNT(transaction_id)		       AS total_sales_transactions,
  5  	 COUNT(DISTINCT customer_id)	       AS unique_registered_shoppers,
  6  	 SUM(total_amount)		       AS gross_sales_revenue,
  7  	 ROUND(AVG(total_amount), 2)	       AS average_order_value,
  8  	 MIN(total_amount)		       AS min_order_value,
  9  	 MAX(total_amount)		       AS max_order_value
 10  FROM SalesTransaction
 11  WHERE status = 'COMPLETED'
 12  GROUP BY TO_CHAR(transaction_date, 'YYYY-MM');

