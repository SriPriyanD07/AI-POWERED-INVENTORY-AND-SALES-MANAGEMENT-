SQL> -- -----------------------------------------------------------------------------
SQL> -- 8. ANALYTIC / WINDOW FUNCTION (RANK & DENSE_RANK)
SQL> -- Description: Rank products by price within their respective product categories.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 8. WINDOW FUNCTION: Ranking Products by Price within Category ===
=== 8. WINDOW FUNCTION: Ranking Products by Price within Category ===
SQL> SELECT
  2  	 cat.category_name,
  3  	 p.product_name,
  4  	 p.standard_unit_price,
  5  	 RANK() OVER (
  6  	     PARTITION BY p.category_id
  7  	     ORDER BY p.standard_unit_price DESC
  8  	 ) AS price_rank_in_cat,
  9  	 DENSE_RANK() OVER (
 10  	     ORDER BY p.standard_unit_price DESC
 11  	 ) AS overall_price_dense_rank
 12  FROM Product p
 13  INNER JOIN ProductCategory cat ON p.category_id = cat.category_id
 14  ORDER BY cat.category_name, price_rank_in_cat;

