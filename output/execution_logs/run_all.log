SQL> -- 4. USER-DEFINED EXCEPTION
SQL> -- Scenario: Business rule validation: Shelf capacity overflow.
SQL> -- 	  If stock to be placed exceeds location capacity, raise custom exception.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === 4. Demonstrating User-Defined Exception: EX_CAPACITY_EXCEEDED ===
=== 4. Demonstrating User-Defined Exception: EX_CAPACITY_EXCEEDED ===
SQL> DECLARE
  2  	 ex_capacity_exceeded EXCEPTION;
  3  	 PRAGMA EXCEPTION_INIT(ex_capacity_exceeded, -20050);
  4  
  5  	 v_target_location NUMBER := 3; -- Shelf 3 has capacity 400
  6  	 v_incoming_units  NUMBER := 1500;
  7  	 v_capacity	   NUMBER;
  8  	 v_current_total   NUMBER;
  9  BEGIN
 10  	 DBMS_OUTPUT.PUT_LINE('Validating shelf restocking capacity for Location ' || v_target_location || '...');
 11  
 12  	 SELECT capacity INTO v_capacity
 13  	 FROM InventoryLocation
 14  	 WHERE location_id = v_target_location;
 15  
 16  	 SELECT NVL(SUM(quantity_on_hand), 0) INTO v_current_total
 17  	 FROM InventoryStock
 18  	 WHERE location_id = v_target_location;
 19  
 20  	 DBMS_OUTPUT.PUT_LINE('Current Stock on Shelf: ' || v_current_total ||
 21  			      ' | Max Capacity: ' || v_capacity ||
 22  			      ' | Incoming Restock: ' || v_incoming_units);
 23  
 24  	 IF (v_current_total + v_incoming_units) > v_capacity THEN
 25  	     RAISE_APPLICATION_ERROR(-20050, 'Shelf capacity exceeded! Available space=' ||
 26  				     (v_capacity - v_current_total) || ', Incoming=' || v_incoming_units);
 27  	 END IF;
 28  EXCEPTION
 29  	 WHEN ex_capacity_exceeded THEN
 30  	     DBMS_OUTPUT.PUT_LINE('--> CAUGHT USER-DEFINED EXCEPTION (-20050):');
 31  	     DBMS_OUTPUT.PUT_LINE('    ' || SQLERRM);
 32  END;
