SQL> -- Synchronize Sequences to highest explicit IDs to prevent DUP_VAL_ON_INDEX on subsequent auto-inserts
SQL> DECLARE
  2  	 v_max_id NUMBER;
  3  	 v_cur_seq NUMBER;
  4  	 PROCEDURE sync_seq(p_seq_name VARCHAR2, p_table_name VARCHAR2, p_col_name VARCHAR2) IS
  5  	     v_diff NUMBER;
  6  	     v_temp NUMBER;
  7  	 BEGIN
  8  	     EXECUTE IMMEDIATE 'SELECT NVL(MAX(' || p_col_name || '), 0) FROM ' || p_table_name INTO v_max_id;
  9  	     EXECUTE IMMEDIATE 'SELECT ' || p_seq_name || '.NEXTVAL FROM dual' INTO v_cur_seq;
 10  	     v_diff := v_max_id - v_cur_seq;
 11  	     IF v_diff > 0 THEN
 12  		 EXECUTE IMMEDIATE 'ALTER SEQUENCE ' || p_seq_name || ' INCREMENT BY ' || v_diff;
 13  		 EXECUTE IMMEDIATE 'SELECT ' || p_seq_name || '.NEXTVAL FROM dual' INTO v_temp;
 14  		 EXECUTE IMMEDIATE 'ALTER SEQUENCE ' || p_seq_name || ' INCREMENT BY 1';
 15  	     END IF;
 16  	 END;
 17  BEGIN
 18  	 sync_seq('SEQ_SUPPLIER_ID',  'Supplier',	      'supplier_id');
 19  	 sync_seq('SEQ_CATEGORY_ID',  'ProductCategory',      'category_id');
 20  	 sync_seq('SEQ_PRODUCT_ID',   'Product',	      'product_id');
 21  	 sync_seq('SEQ_EMPLOYEE_ID',  'Employee',	      'employee_id');
 22  	 sync_seq('SEQ_PO_ID',	      'PurchaseOrder',	      'po_id');
 23  	 sync_seq('SEQ_SHIPMENT_ID',  'Shipment',	      'shipment_id');
 24  	 sync_seq('SEQ_LOCATION_ID',  'InventoryLocation',    'location_id');
 25  	 sync_seq('SEQ_INV_TXN_ID',   'InventoryTransaction', 'transaction_id');
 26  	 sync_seq('SEQ_RESTOCK_ID',   'RestockEvent',	      'restock_id');
 27  	 sync_seq('SEQ_TRIGGER_ID',   'ReorderTrigger',       'trigger_id');
 28  	 sync_seq('SEQ_CUSTOMER_ID',  'Customer',	      'customer_id');
 29  	 sync_seq('SEQ_SALES_TXN_ID', 'SalesTransaction',     'transaction_id');
 30  	 sync_seq('SEQ_PAYMENT_ID',   'Payment',	      'payment_id');
 31  	 DBMS_OUTPUT.PUT_LINE('Sequences successfully synchronized with seed data IDs.');
 32  END;
 33  /
Sequences successfully synchronized with seed data IDs.                                                                                     

PL/SQL procedure successfully completed.

