SQL> -- 5. VIEW: vw_supplier_performance
SQL> -- Description: Evaluates suppliers across PO volume, total procurement spend,
SQL> -- 	     received deliveries, and vendor ratings.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Creating VIEW: vw_supplier_performance ===
=== Creating VIEW: vw_supplier_performance ===
SQL> CREATE OR REPLACE VIEW vw_supplier_performance AS
  2  SELECT
  3  	 s.supplier_id,
  4  	 s.supplier_name,
  5  	 s.contact_person,
  6  	 s.rating,
  7  	 COUNT(DISTINCT po.po_id)	      AS total_pos_placed,
  8  	 NVL(SUM(po.total_amount), 0)	      AS total_procurement_spend,
  9  	 COUNT(DISTINCT sh.shipment_id)       AS shipments_received
 10  FROM Supplier s
 11  LEFT JOIN PurchaseOrder po ON s.supplier_id = po.supplier_id
 12  LEFT JOIN Shipment sh	ON po.po_id = sh.po_id AND sh.status = 'RECEIVED'
 13  GROUP BY s.supplier_id, s.supplier_name, s.contact_person, s.rating;

