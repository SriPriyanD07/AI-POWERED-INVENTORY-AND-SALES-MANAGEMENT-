SQL> -- 1. DROP PROCEDURES & FUNCTIONS
SQL> -- -----------------------------------------------------------------------------
SQL> DECLARE
  2  	 PROCEDURE drop_object(p_type VARCHAR2, p_name VARCHAR2) IS
  3  	 BEGIN
  4  	     EXECUTE IMMEDIATE 'DROP ' || p_type || ' ' || p_name;
  5  	     DBMS_OUTPUT.PUT_LINE('Dropped ' || p_type || ': ' || p_name);
  6  	 EXCEPTION
  7  	     WHEN OTHERS THEN
  8  		 IF SQLCODE != -4043 THEN -- ORA-04043: object does not exist
  9  		     DBMS_OUTPUT.PUT_LINE('Warning dropping ' || p_name || ': ' || SQLERRM);
 10  		 END IF;
 11  	 END;
 12  BEGIN
 13  	 drop_object('PROCEDURE', 'PROCESS_SALE');
 14  	 drop_object('PROCEDURE', 'RECEIVE_SHIPMENT');
 15  	 drop_object('PROCEDURE', 'TRANSFER_STOCK');
 16  	 drop_object('PROCEDURE', 'CREATE_PURCHASE_ORDER');
 17  	 drop_object('FUNCTION',  'CALCULATE_SALE_TOTAL');
 18  	 drop_object('FUNCTION',  'CALCULATE_STOCK_VALUE');
 19  	 drop_object('FUNCTION',  'CALCULATE_LOYALTY_POINTS');
 20  END;
 21  /
