SQL> -- 4. VIEW: vw_top_selling_products
SQL> -- Description: Ranks products by units sold and gross sales revenue.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Creating VIEW: vw_top_selling_products ===
=== Creating VIEW: vw_top_selling_products ===
SQL> CREATE OR REPLACE VIEW vw_top_selling_products AS
  2  SELECT
  3  	 p.product_id,
  4  	 p.sku,
  5  	 p.product_name,
  6  	 cat.category_name,
  7  	 COUNT(DISTINCT stl.transaction_id)	     AS orders_count,
  8  	 SUM(stl.quantity_sold) 		     AS total_units_sold,
  9  	 SUM(stl.quantity_sold * stl.unit_price)     AS total_sales_revenue
 10  FROM SalesTransactionLine stl
 11  INNER JOIN SalesTransaction st ON stl.transaction_id = st.transaction_id
 12  INNER JOIN Product p	    ON stl.product_id = p.product_id
 13  INNER JOIN ProductCategory cat ON p.category_id = cat.category_id
 14  WHERE st.status = 'COMPLETED'
 15  GROUP BY p.product_id, p.sku, p.product_name, cat.category_name;

