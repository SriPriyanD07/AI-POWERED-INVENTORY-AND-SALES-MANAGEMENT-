SQL> -- 2. PROCEDURE: RECEIVE_SHIPMENT
SQL> -- Description: Validates inbound shipment, increments warehouse inventory stock,
SQL> -- 	     writes RECEIPT ledger rows, and updates shipment/PO statuses.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE PROCEDURE RECEIVE_SHIPMENT (
  2  	 p_shipment_id		 IN NUMBER,
  3  	 p_warehouse_location_id IN NUMBER,
  4  	 p_received_by		 IN NUMBER
  5  ) IS
  6  	 v_loc_type	 VARCHAR2(20);
  7  	 v_po_id	 NUMBER(10);
  8  	 v_ship_status	 VARCHAR2(30);
  9  	 v_rows_updated  NUMBER := 0;
 10  BEGIN
 11  	 -- 1. Validate Target Location is WAREHOUSE
 12  	 BEGIN
 13  	     SELECT location_type INTO v_loc_type
 14  	     FROM InventoryLocation
 15  	     WHERE location_id = p_warehouse_location_id;
 16  	 EXCEPTION
 17  	     WHEN NO_DATA_FOUND THEN
 18  		 RAISE_APPLICATION_ERROR(-20020, 'Warehouse Location ID ' || p_warehouse_location_id || ' does not exist.');
 19  	 END;
 20  
 21  	 IF v_loc_type != 'WAREHOUSE' THEN
 22  	     RAISE_APPLICATION_ERROR(-20021, 'Shipment Receiving Error: Inbound goods must enter a WAREHOUSE, not a SHELF.');
 23  	 END IF;
 24  
 25  	 -- 2. Validate Shipment
 26  	 BEGIN
 27  	     SELECT po_id, status INTO v_po_id, v_ship_status
 28  	     FROM Shipment
 29  	     WHERE shipment_id = p_shipment_id;
 30  	 EXCEPTION
 31  	     WHEN NO_DATA_FOUND THEN
 32  		 RAISE_APPLICATION_ERROR(-20022, 'Shipment ID ' || p_shipment_id || ' does not exist.');
 33  	 END;
 34  
 35  	 IF v_ship_status = 'RECEIVED' THEN
 36  	     RAISE_APPLICATION_ERROR(-20023, 'Shipment ID ' || p_shipment_id || ' has already been received.');
 37  	 END IF;
 38  
 39  	 -- 3. Process Each Shipment Line
 40  	 FOR r IN (
 41  	     SELECT product_id, quantity_shipped, quantity_received
 42  	     FROM ShipmentLine
 43  	     WHERE shipment_id = p_shipment_id
 44  	 ) LOOP
 45  	     -- Update shipment line received quantity
 46  	     UPDATE ShipmentLine
 47  	     SET quantity_received = r.quantity_shipped
 48  	     WHERE shipment_id = p_shipment_id
 49  	       AND product_id = r.product_id;
 50  
 51  	     -- Upsert stock into warehouse
 52  	     MERGE INTO InventoryStock stk
 53  	     USING dual ON (stk.location_id = p_warehouse_location_id AND stk.product_id = r.product_id)
 54  	     WHEN MATCHED THEN
 55  		 UPDATE SET stk.quantity_on_hand = stk.quantity_on_hand + r.quantity_shipped,
 56  			    stk.last_updated_at = SYSTIMESTAMP
 57  	     WHEN NOT MATCHED THEN
 58  		 INSERT (location_id, product_id, quantity_on_hand, reorder_threshold, reorder_quantity, last_updated_at)
 59  		 VALUES (p_warehouse_location_id, r.product_id, r.quantity_shipped, 20, 50, SYSTIMESTAMP);
 60  
 61  	     -- Record RECEIPT ledger entry
 62  	     INSERT INTO InventoryTransaction (
 63  		 transaction_id, product_id, location_id, transaction_type,
 64  		 quantity, transaction_date, reference_type, reference_id
 65  	     ) VALUES (
 66  		 SEQ_INV_TXN_ID.NEXTVAL, r.product_id, p_warehouse_location_id, 'RECEIPT',
 67  		 r.quantity_shipped, SYSTIMESTAMP, 'SHIPMENT', p_shipment_id
 68  	     );
 69  
 70  	     v_rows_updated := v_rows_updated + 1;
 71  	 END LOOP;
 72  
 73  	 -- 4. Update Shipment Status
 74  	 UPDATE Shipment
 75  	 SET status = 'RECEIVED',
 76  	     received_date = SYSDATE,
 77  	     received_by = p_received_by
 78  	 WHERE shipment_id = p_shipment_id;
 79  
 80  	 -- 5. Update Purchase Order Status to COMPLETED
 81  	 UPDATE PurchaseOrder
 82  	 SET status = 'COMPLETED'
 83  	 WHERE po_id = v_po_id;
 84  
 85  	 DBMS_OUTPUT.PUT_LINE('RECEIVE_SHIPMENT SUCCESS: ShipmentID=' || p_shipment_id ||
 86  			      ', PO=' || v_po_id ||
 87  			      ', Products Received=' || v_rows_updated ||
 88  			      ', Target Warehouse=' || p_warehouse_location_id);
 89  END RECEIVE_SHIPMENT;
 90  /

Procedure created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 3. PROCEDURE: TRANSFER_STOCK
SQL> -- Description: Restocks goods from warehouse to shelf. Validates stock,
SQL> -- 	     decrements source, increments destination, logs TRANSFER_OUT and
SQL> -- 	     TRANSFER_IN ledger records, and creates a RestockEvent.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE PROCEDURE TRANSFER_STOCK (
  2  	 p_product_id	     IN NUMBER,
  3  	 p_from_location_id  IN NUMBER,
  4  	 p_to_location_id    IN NUMBER,
  5  	 p_quantity	     IN NUMBER,
  6  	 p_employee_id	     IN NUMBER DEFAULT NULL,
  7  	 p_triggered_by      IN VARCHAR2 DEFAULT 'MANUAL_REQUEST'
  8  ) IS
  9  	 v_src_qoh	     NUMBER(8);
 10  	 v_src_type	     VARCHAR2(20);
 11  	 v_dst_type	     VARCHAR2(20);
 12  	 v_restock_id	     NUMBER(10);
 13  BEGIN
 14  	 -- 1. Validate Identical Locations
 15  	 IF p_from_location_id = p_to_location_id THEN
 16  	     RAISE_APPLICATION_ERROR(-20030, 'Transfer Error: Source and destination locations cannot be identical.');
 17  	 END IF;
 18  
 19  	 IF p_quantity <= 0 THEN
 20  	     RAISE_APPLICATION_ERROR(-20031, 'Transfer Error: Quantity must be strictly greater than 0.');
 21  	 END IF;
 22  
 23  	 -- 2. Validate Source Stock
 24  	 BEGIN
 25  	     SELECT quantity_on_hand INTO v_src_qoh
 26  	     FROM InventoryStock
 27  	     WHERE location_id = p_from_location_id
 28  	       AND product_id = p_product_id
 29  	     FOR UPDATE;
 30  	 EXCEPTION
 31  	     WHEN NO_DATA_FOUND THEN
 32  		 RAISE_APPLICATION_ERROR(-20032, 'Source stock record not found for product ' || p_product_id);
 33  	 END;
 34  
 35  	 IF v_src_qoh < p_quantity THEN
 36  	     RAISE_APPLICATION_ERROR(-20033, 'Transfer Error: Insufficient stock at source. Available=' ||
 37  				     v_src_qoh || ', Requested=' || p_quantity);
 38  	 END IF;
 39  
 40  	 -- 3. Decrement Source Stock
 41  	 UPDATE InventoryStock
 42  	 SET quantity_on_hand = quantity_on_hand - p_quantity,
 43  	     last_updated_at = SYSTIMESTAMP
 44  	 WHERE location_id = p_from_location_id
 45  	   AND product_id = p_product_id;
 46  
 47  	 -- 4. Increment Destination Stock (Upsert)
 48  	 MERGE INTO InventoryStock stk
 49  	 USING dual ON (stk.location_id = p_to_location_id AND stk.product_id = p_product_id)
 50  	 WHEN MATCHED THEN
 51  	     UPDATE SET stk.quantity_on_hand = stk.quantity_on_hand + p_quantity,
 52  			stk.last_updated_at = SYSTIMESTAMP
 53  	 WHEN NOT MATCHED THEN
 54  	     INSERT (location_id, product_id, quantity_on_hand, reorder_threshold, reorder_quantity, last_updated_at)
 55  	     VALUES (p_to_location_id, p_product_id, p_quantity, 10, 20, SYSTIMESTAMP);
 56  
 57  	 -- 5. Create RestockEvent record
 58  	 SELECT SEQ_RESTOCK_ID.NEXTVAL INTO v_restock_id FROM dual;
 59  
 60  	 INSERT INTO RestockEvent (
 61  	     restock_id, product_id, from_location_id, to_location_id,
 62  	     quantity_moved, event_date, triggered_by, performed_by, status
 63  	 ) VALUES (
 64  	     v_restock_id, p_product_id, p_from_location_id, p_to_location_id,
 65  	     p_quantity, SYSTIMESTAMP, p_triggered_by, p_employee_id, 'COMPLETED'
 66  	 );
 67  
 68  	 -- 6. Record TRANSFER_OUT Ledger Row
 69  	 INSERT INTO InventoryTransaction (
 70  	     transaction_id, product_id, location_id, transaction_type,
 71  	     quantity, transaction_date, reference_type, reference_id
 72  	 ) VALUES (
 73  	     SEQ_INV_TXN_ID.NEXTVAL, p_product_id, p_from_location_id, 'TRANSFER_OUT',
 74  	     -p_quantity, SYSTIMESTAMP, 'RESTOCK', v_restock_id
 75  	 );
 76  
 77  	 -- 7. Record TRANSFER_IN Ledger Row
 78  	 INSERT INTO InventoryTransaction (
 79  	     transaction_id, product_id, location_id, transaction_type,
 80  	     quantity, transaction_date, reference_type, reference_id
 81  	 ) VALUES (
 82  	     SEQ_INV_TXN_ID.NEXTVAL, p_product_id, p_to_location_id, 'TRANSFER_IN',
 83  	     p_quantity, SYSTIMESTAMP, 'RESTOCK', v_restock_id
 84  	 );
 85  
 86  	 DBMS_OUTPUT.PUT_LINE('TRANSFER_STOCK SUCCESS: RestockID=' || v_restock_id ||
 87  			      ', Product=' || p_product_id ||
 88  			      ', Moved=' || p_quantity ||
 89  			      ' from Loc ' || p_from_location_id || ' to Loc ' || p_to_location_id);
 90  END TRANSFER_STOCK;
 91  /

Procedure created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 4. PROCEDURE: CREATE_PURCHASE_ORDER
SQL> -- Description: Validates vendor and buyer, creates PO header & line, computes
SQL> -- 	     total amount, and supports manual or automated triggering.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE PROCEDURE CREATE_PURCHASE_ORDER (
  2  	 p_po_number	      IN  VARCHAR2,
  3  	 p_supplier_id	      IN  NUMBER,
  4  	 p_created_by	      IN  NUMBER,
  5  	 p_product_id	      IN  NUMBER,
  6  	 p_quantity	      IN  NUMBER,
  7  	 p_unit_price	      IN  NUMBER,
  8  	 p_is_auto_generated  IN  VARCHAR2 DEFAULT 'FALSE',
  9  	 p_po_id	      OUT NUMBER
 10  ) IS
 11  	 v_po_id	 NUMBER(10);
 12  	 v_line_total	 NUMBER(12,2);
 13  	 v_dummy	 NUMBER;
 14  BEGIN
 15  	 -- 1. Validate Supplier
 16  	 BEGIN
 17  	     SELECT 1 INTO v_dummy FROM Supplier WHERE supplier_id = p_supplier_id;
 18  	 EXCEPTION
 19  	     WHEN NO_DATA_FOUND THEN
 20  		 RAISE_APPLICATION_ERROR(-20040, 'Supplier ID ' || p_supplier_id || ' does not exist.');
 21  	 END;
 22  
 23  	 -- 2. Validate Employee
 24  	 BEGIN
 25  	     SELECT 1 INTO v_dummy FROM Employee WHERE employee_id = p_created_by;
 26  	 EXCEPTION
 27  	     WHEN NO_DATA_FOUND THEN
 28  		 RAISE_APPLICATION_ERROR(-20041, 'Employee ID ' || p_created_by || ' does not exist.');
 29  	 END;
 30  
 31  	 -- 3. Validate Product
 32  	 BEGIN
 33  	     SELECT 1 INTO v_dummy FROM Product WHERE product_id = p_product_id;
 34  	 EXCEPTION
 35  	     WHEN NO_DATA_FOUND THEN
 36  		 RAISE_APPLICATION_ERROR(-20042, 'Product ID ' || p_product_id || ' does not exist.');
 37  	 END;
 38  
 39  	 IF p_quantity <= 0 OR p_unit_price <= 0 THEN
 40  	     RAISE_APPLICATION_ERROR(-20043, 'Quantity and Unit Price must be strictly positive.');
 41  	 END IF;
 42  
 43  	 v_line_total := p_quantity * p_unit_price;
 44  
 45  	 -- 4. Insert PurchaseOrder Header (Initialized to 0; maintained by trigger TRG_PO_LINE_TOTAL_SYNC)
 46  	 SELECT SEQ_PO_ID.NEXTVAL INTO v_po_id FROM dual;
 47  
 48  	 INSERT INTO PurchaseOrder (
 49  	     po_id, po_number, supplier_id, created_by, order_date,
 50  	     expected_delivery_date, status, total_amount, is_auto_generated
 51  	 ) VALUES (
 52  	     v_po_id, p_po_number, p_supplier_id, p_created_by, SYSDATE,
 53  	     SYSDATE + 7, 'PENDING', 0.00, p_is_auto_generated
 54  	 );
 55  
 56  	 -- 5. Insert PurchaseOrderLine
 57  	 INSERT INTO PurchaseOrderLine (
 58  	     po_id, product_id, quantity_ordered, unit_price
 59  	 ) VALUES (
 60  	     v_po_id, p_product_id, p_quantity, p_unit_price
 61  	 );
 62  
 63  	 p_po_id := v_po_id;
 64  
 65  	 DBMS_OUTPUT.PUT_LINE('CREATE_PURCHASE_ORDER SUCCESS: PO_ID=' || v_po_id ||
 66  			      ', PO_Number=' || p_po_number ||
 67  			      ', Line Total=' || v_line_total ||
 68  			      ', AutoGenerated=' || p_is_auto_generated);
 69  END CREATE_PURCHASE_ORDER;
 70  /

Procedure created.

