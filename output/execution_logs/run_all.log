 18  	     'Employee',
 19  	     'Product',
 20  	     'ProductCategory',
 21  	     'SupplierPhone',
 22  	     'Supplier'
 23  	 );
 24  BEGIN
 25  	 FOR i IN 1..v_tables.COUNT LOOP
 26  	     BEGIN
 27  		 EXECUTE IMMEDIATE 'DROP TABLE ' || v_tables(i) || ' CASCADE CONSTRAINTS PURGE';
 28  		 DBMS_OUTPUT.PUT_LINE('Dropped TABLE: ' || v_tables(i));
 29  	     EXCEPTION
 30  		 WHEN OTHERS THEN
 31  		     IF SQLCODE != -942 THEN -- ORA-00942: table or view does not exist
 32  			 DBMS_OUTPUT.PUT_LINE('Warning dropping table ' || v_tables(i) || ': ' || SQLERRM);
 33  		     END IF;
 34  	     END;
 35  	 END LOOP;
 36  END;
