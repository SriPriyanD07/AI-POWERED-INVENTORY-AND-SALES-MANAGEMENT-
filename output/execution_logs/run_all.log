SQL> -- -----------------------------------------------------------------------------
SQL> -- 1. TRIGGER: TRG_PO_LINE_TOTAL_SYNC
SQL> -- Description: Automatically synchronizes PurchaseOrder.total_amount when
SQL> -- 	     PurchaseOrderLine rows are added, updated, or deleted.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER TRG_PO_LINE_TOTAL_SYNC
  2  AFTER INSERT OR UPDATE OR DELETE ON PurchaseOrderLine
  3  FOR EACH ROW
  4  BEGIN
  5  	 IF INSERTING THEN
  6  	     UPDATE PurchaseOrder
  7  	     SET total_amount = total_amount + (:NEW.quantity_ordered * :NEW.unit_price)
  8  	     WHERE po_id = :NEW.po_id;
  9  	 ELSIF UPDATING THEN
 10  	     UPDATE PurchaseOrder
 11  	     SET total_amount = total_amount
 12  			      - (:OLD.quantity_ordered * :OLD.unit_price)
 13  			      + (:NEW.quantity_ordered * :NEW.unit_price)
 14  	     WHERE po_id = :NEW.po_id;
 15  	 ELSIF DELETING THEN
 16  	     UPDATE PurchaseOrder
 17  	     SET total_amount = total_amount - (:OLD.quantity_ordered * :OLD.unit_price)
 18  	     WHERE po_id = :OLD.po_id;
 19  	 END IF;
 20  END;
 21  /

Trigger created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 2. TRIGGER: TRG_SALE_LINE_TOTAL_SYNC
SQL> -- Description: Automatically synchronizes SalesTransaction.total_amount when
SQL> -- 	     SalesTransactionLine rows are added, updated, or deleted.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER TRG_SALE_LINE_TOTAL_SYNC
  2  AFTER INSERT OR UPDATE OR DELETE ON SalesTransactionLine
  3  FOR EACH ROW
  4  BEGIN
  5  	 IF INSERTING THEN
  6  	     UPDATE SalesTransaction
  7  	     SET total_amount = total_amount + (:NEW.quantity_sold * :NEW.unit_price)
  8  	     WHERE transaction_id = :NEW.transaction_id;
  9  	 ELSIF UPDATING THEN
 10  	     UPDATE SalesTransaction
 11  	     SET total_amount = total_amount
 12  			      - (:OLD.quantity_sold * :OLD.unit_price)
 13  			      + (:NEW.quantity_sold * :NEW.unit_price)
 14  	     WHERE transaction_id = :NEW.transaction_id;
 15  	 ELSIF DELETING THEN
 16  	     UPDATE SalesTransaction
 17  	     SET total_amount = total_amount - (:OLD.quantity_sold * :OLD.unit_price)
 18  	     WHERE transaction_id = :OLD.transaction_id;
 19  	 END IF;
 20  END;
 21  /

Trigger created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 3. TRIGGER: TRG_PREVENT_NEGATIVE_STOCK
SQL> -- Description: Enforces database-level constraint preventing stock from dropping
SQL> -- 	     below zero under any circumstance.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER TRG_PREVENT_NEGATIVE_STOCK
  2  BEFORE UPDATE OF quantity_on_hand ON InventoryStock
  3  FOR EACH ROW
  4  BEGIN
  5  	 IF :NEW.quantity_on_hand < 0 THEN
  6  	     RAISE_APPLICATION_ERROR(-20060, 'Trigger Alert: Stock quantity cannot be negative. Attempted QOH: ' ||
  7  				     :NEW.quantity_on_hand);
  8  	 END IF;
  9  END;
 10  /

Trigger created.

SQL> 
SQL> -- -----------------------------------------------------------------------------
SQL> -- 4. TRIGGER: TRG_STOCK_THRESHOLD_ALERT
SQL> -- Description: Evaluates live stock updates.
SQL> --   - For SHELF: If QOH <= reorder_threshold, auto-creates RestockEvent (Warehouse->Shelf)
SQL> --   - For WAREHOUSE: If QOH <= reorder_threshold, auto-creates ReorderTrigger
SQL> -- Avoids duplicate alerts if an open/pending event already exists.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE TRIGGER TRG_STOCK_THRESHOLD_ALERT
  2  AFTER UPDATE OF quantity_on_hand ON InventoryStock
  3  FOR EACH ROW
  4  WHEN (NEW.quantity_on_hand <= NEW.reorder_threshold)
  5  DECLARE
  6  	 v_loc_type    VARCHAR2(20);
  7  	 v_parent_wh   NUMBER(10);
  8  	 v_existing    NUMBER;
  9  	 v_from_wh     NUMBER(10);
 10  BEGIN
 11  	 -- Look up location attributes
 12  	 SELECT location_type, parent_location_id
 13  	 INTO v_loc_type, v_parent_wh
 14  	 FROM InventoryLocation
 15  	 WHERE location_id = :NEW.location_id;
 16  
 17  	 IF v_loc_type = 'SHELF' THEN
 18  	     -- Check if an active PENDING restock event already exists
 19  	     SELECT COUNT(*)
 20  	     INTO v_existing
 21  	     FROM RestockEvent
 22  	     WHERE product_id = :NEW.product_id
 23  	       AND to_location_id = :NEW.location_id
 24  	       AND status IN ('PENDING', 'IN_PROGRESS');
 25  
 26  	     IF v_existing = 0 THEN
 27  		 -- Determine supply warehouse (parent warehouse or fallback to Warehouse 1)
 28  		 v_from_wh := NVL(v_parent_wh, 1);
 29  
 30  		 INSERT INTO RestockEvent (
 31  		     restock_id, product_id, from_location_id, to_location_id,
 32  		     quantity_moved, event_date, triggered_by, performed_by, status
 33  		 ) VALUES (
 34  		     SEQ_RESTOCK_ID.NEXTVAL, :NEW.product_id, v_from_wh, :NEW.location_id,
 35  		     :NEW.reorder_quantity, SYSTIMESTAMP, 'AUTO_THRESHOLD', NULL, 'PENDING'
 36  		 );
 37  	     END IF;
 38  
 39  	 ELSIF v_loc_type = 'WAREHOUSE' THEN
 40  	     -- Check if an active OPEN reorder trigger already exists
 41  	     SELECT COUNT(*)
 42  	     INTO v_existing
 43  	     FROM ReorderTrigger
 44  	     WHERE product_id = :NEW.product_id
 45  	       AND location_id = :NEW.location_id
 46  	       AND status = 'OPEN';
 47  
 48  	     IF v_existing = 0 THEN
 49  		 INSERT INTO ReorderTrigger (
 50  		     trigger_id, product_id, location_id, stock_at_trigger,
 51  		     threshold_at_trigger, trigger_date, generated_po_id, status
 52  		 ) VALUES (
 53  		     SEQ_TRIGGER_ID.NEXTVAL, :NEW.product_id, :NEW.location_id,
 54  		     :NEW.quantity_on_hand, :NEW.reorder_threshold, SYSTIMESTAMP, NULL, 'OPEN'
 55  		 );
 56  	     END IF;
 57  	 END IF;
 58  EXCEPTION
 59  	 WHEN OTHERS THEN
 60  	     -- Log or silently handle lookup anomalies to avoid blocking caller
 61  	     NULL;
 62  END;
 63  /

Trigger created.

