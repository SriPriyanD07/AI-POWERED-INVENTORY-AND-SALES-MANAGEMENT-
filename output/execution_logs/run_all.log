SQL> -- -----------------------------------------------------------------------------
SQL> -- 2. VIEW: vw_product_stock
SQL> -- Description: Master inventory view aggregating warehouse units, shelf units,
SQL> -- 	     total company inventory, and total asset valuation per product.
SQL> -- -----------------------------------------------------------------------------
SQL> PROMPT === Creating VIEW: vw_product_stock ===
=== Creating VIEW: vw_product_stock ===
SQL> CREATE OR REPLACE VIEW vw_product_stock AS
  2  SELECT
  3  	 p.product_id,
  4  	 p.sku,
  5  	 p.product_name,
  6  	 cat.category_name,
  7  	 p.standard_unit_price,
  8  	 NVL(SUM(CASE WHEN loc.location_type = 'WAREHOUSE' THEN stk.quantity_on_hand ELSE 0 END), 0) AS warehouse_stock,
  9  	 NVL(SUM(CASE WHEN loc.location_type = 'SHELF'	   THEN stk.quantity_on_hand ELSE 0 END), 0) AS shelf_stock,
 10  	 NVL(SUM(stk.quantity_on_hand), 0) AS total_stock_on_hand,
 11  	 ROUND(NVL(SUM(stk.quantity_on_hand * p.standard_unit_price), 0), 2) AS total_inventory_value
 12  FROM Product p
 13  INNER JOIN ProductCategory cat   ON p.category_id = cat.category_id
 14  LEFT JOIN InventoryStock stk     ON p.product_id = stk.product_id
 15  LEFT JOIN InventoryLocation loc  ON stk.location_id = loc.location_id
 16  GROUP BY p.product_id, p.sku, p.product_name, cat.category_name, p.standard_unit_price;

