SQL> PROMPT === 3. MULTI-TABLE JOIN: Detailed POS Sales Receipts with Shelf Location ===
=== 3. MULTI-TABLE JOIN: Detailed POS Sales Receipts with Shelf Location ===
SQL> SELECT
  2  	 st.receipt_number,
  3  	 st.transaction_date,
  4  	 p.sku,
  5  	 p.product_name,
  6  	 cat.category_name,
  7  	 loc.location_name AS shelf_dispensed_from,
  8  	 stl.quantity_sold,
  9  	 stl.unit_price,
 10  	 (stl.quantity_sold * stl.unit_price) AS line_subtotal
 11  FROM SalesTransaction st
 12  INNER JOIN SalesTransactionLine stl ON st.transaction_id = stl.transaction_id
 13  INNER JOIN Product p		 ON stl.product_id = p.product_id
 14  INNER JOIN ProductCategory cat	 ON p.category_id = cat.category_id
 15  INNER JOIN InventoryLocation loc	 ON stl.shelf_location_id = loc.location_id
 16  ORDER BY st.receipt_number, p.product_name;

