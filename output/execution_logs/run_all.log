SQL> -- 1. PROCEDURE: PROCESS_SALE
SQL> -- Description: Validates shelf stock, creates sales header & line, deducts shelf
SQL> -- 	     inventory, inserts SALE ledger entry, and calculates sale total.
SQL> -- -----------------------------------------------------------------------------
SQL> CREATE OR REPLACE PROCEDURE PROCESS_SALE (
  2  	 p_receipt_number     IN  VARCHAR2,
  3  	 p_customer_id	      IN  NUMBER,
  4  	 p_cashier_id	      IN  NUMBER,
  5  	 p_shelf_location_id  IN  NUMBER,
  6  	 p_product_id	      IN  NUMBER,
  7  	 p_quantity	      IN  NUMBER,
  8  	 p_unit_price	      IN  NUMBER,
  9  	 p_transaction_id     OUT NUMBER,
 10  	 p_total_amount       OUT NUMBER
 11  ) IS
 12  	 v_loc_type	     VARCHAR2(20);
 13  	 v_stock_qoh	     NUMBER(8);
 14  	 v_is_active	     VARCHAR2(5);
 15  	 v_actual_price      NUMBER(10,2);
 16  	 v_txn_id	     NUMBER(10);
 17  	 v_line_subtotal     NUMBER(10,2);
 18  
 19  	 -- User-defined exceptions
 20  	 ex_invalid_location EXCEPTION;
 21  	 ex_inactive_product EXCEPTION;
 22  	 ex_insufficient_stock EXCEPTION;
 23  BEGIN
 24  	 -- 1. Validate Product
 25  	 BEGIN
 26  	     SELECT is_active, standard_unit_price
 27  	     INTO v_is_active, v_actual_price
 28  	     FROM Product
 29  	     WHERE product_id = p_product_id;
 30  	 EXCEPTION
 31  	     WHEN NO_DATA_FOUND THEN
 32  		 RAISE_APPLICATION_ERROR(-20001, 'Product ID ' || p_product_id || ' does not exist.');
 33  	 END;
 34  
 35  	 IF v_is_active != 'TRUE' THEN
 36  	     RAISE ex_inactive_product;
 37  	 END IF;
 38  
 39  	 -- Use provided unit price or default to standard unit price
 40  	 IF p_unit_price IS NOT NULL AND p_unit_price > 0 THEN
 41  	     v_actual_price := p_unit_price;
 42  	 END IF;
 43  
 44  	 -- 2. Validate Shelf Location (Sales must strictly dispense from SHELF)
 45  	 BEGIN
 46  	     SELECT location_type
 47  	     INTO v_loc_type
 48  	     FROM InventoryLocation
 49  	     WHERE location_id = p_shelf_location_id;
 50  	 EXCEPTION
 51  	     WHEN NO_DATA_FOUND THEN
 52  		 RAISE_APPLICATION_ERROR(-20002, 'Location ID ' || p_shelf_location_id || ' does not exist.');
 53  	 END;
 54  
 55  	 IF v_loc_type != 'SHELF' THEN
 56  	     RAISE ex_invalid_location;
 57  	 END IF;
 58  
 59  	 -- 3. Validate Live Stock Sufficiency
 60  	 BEGIN
 61  	     SELECT quantity_on_hand
 62  	     INTO v_stock_qoh
 63  	     FROM InventoryStock
 64  	     WHERE location_id = p_shelf_location_id
 65  	       AND product_id = p_product_id
 66  	     FOR UPDATE; -- Row-level lock to guarantee concurrency safety
 67  	 EXCEPTION
 68  	     WHEN NO_DATA_FOUND THEN
 69  		 RAISE_APPLICATION_ERROR(-20003, 'Product is not stocked at shelf location ' || p_shelf_location_id);
 70  	 END;
 71  
 72  	 IF v_stock_qoh < p_quantity THEN
 73  	     RAISE ex_insufficient_stock;
 74  	 END IF;
 75  
 76  	 -- 4. Calculate Subtotal
 77  	 v_line_subtotal := p_quantity * v_actual_price;
 78  
 79  	 -- 5. Insert SalesTransaction Header (Initialized to 0; maintained by trigger TRG_SALE_LINE_TOTAL_SYNC)
 80  	 SELECT SEQ_SALES_TXN_ID.NEXTVAL INTO v_txn_id FROM dual;
 81  
 82  	 INSERT INTO SalesTransaction (
 83  	     transaction_id, receipt_number, customer_id, cashier_id,
 84  	     transaction_date, total_amount, status
 85  	 ) VALUES (
 86  	     v_txn_id, p_receipt_number, p_customer_id, p_cashier_id,
 87  	     SYSTIMESTAMP, 0.00, 'COMPLETED'
 88  	 );
 89  
 90  	 -- 6. Insert SalesTransactionLine
 91  	 INSERT INTO SalesTransactionLine (
 92  	     transaction_id, product_id, shelf_location_id, quantity_sold, unit_price
 93  	 ) VALUES (
 94  	     v_txn_id, p_product_id, p_shelf_location_id, p_quantity, v_actual_price
 95  	 );
 96  
 97  	 -- 7. Deduct Shelf Stock
 98  	 UPDATE InventoryStock
 99  	 SET quantity_on_hand = quantity_on_hand - p_quantity,
100  	     last_updated_at = SYSTIMESTAMP
101  	 WHERE location_id = p_shelf_location_id
102  	   AND product_id = p_product_id;
103  
104  	 -- 8. Record Immutable Stock Ledger Entry
105  	 INSERT INTO InventoryTransaction (
106  	     transaction_id, product_id, location_id, transaction_type,
107  	     quantity, transaction_date, reference_type, reference_id
108  	 ) VALUES (
109  	     SEQ_INV_TXN_ID.NEXTVAL, p_product_id, p_shelf_location_id, 'SALE',
110  	     -p_quantity, SYSTIMESTAMP, 'SALE', v_txn_id
111  	 );
112  
113  	 -- Set OUT parameters
114  	 p_transaction_id := v_txn_id;
115  	 p_total_amount   := v_line_subtotal;
116  
117  	 DBMS_OUTPUT.PUT_LINE('PROCESS_SALE SUCCESS: TxnID=' || v_txn_id ||
118  			      ', Receipt=' || p_receipt_number ||
119  			      ', Units Sold=' || p_quantity ||
120  			      ', Total=' || v_line_subtotal);
121  EXCEPTION
122  	 WHEN ex_invalid_location THEN
123  	     RAISE_APPLICATION_ERROR(-20010, 'Sale Rejected: Specified location is not a SHELF.');
124  	 WHEN ex_inactive_product THEN
125  	     RAISE_APPLICATION_ERROR(-20011, 'Sale Rejected: Product is discontinued or inactive.');
126  	 WHEN ex_insufficient_stock THEN
127  	     RAISE_APPLICATION_ERROR(-20012, 'Sale Rejected: Insufficient shelf stock. Available=' ||
128  				     v_stock_qoh || ', Requested=' || p_quantity);
129  END PROCESS_SALE;
130  /

Procedure created.

