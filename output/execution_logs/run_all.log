SQL> PROMPT === TEST 13: Rollback Restores State After Aborted Operation ===
=== TEST 13: Rollback Restores State After Aborted Operation ===
SQL> DECLARE
  2  	 v_count_before NUMBER;
  3  	 v_count_during NUMBER;
  4  	 v_count_after	NUMBER;
  5  BEGIN
  6  	 SELECT COUNT(*) INTO v_count_before FROM Customer;
  7  
  8  	 -- Uncommitted Insert
  9  	 INSERT INTO Customer (customer_id, first_name, last_name, email, loyalty_points, membership_type)
 10  	 VALUES (990, 'Rollback', 'Tester', 'rb.tester@example.com', 0, 'REGULAR');
 11  
 12  	 SELECT COUNT(*) INTO v_count_during FROM Customer;
 13  
 14  	 -- Abort / Rollback
 15  	 ROLLBACK;
 16  
 17  	 SELECT COUNT(*) INTO v_count_after FROM Customer;
 18  
 19  	 IF v_count_before = v_count_after AND v_count_during = (v_count_before + 1) THEN
 20  	     DBMS_OUTPUT.PUT_LINE('[PASS] TEST 13: ROLLBACK successfully revoked uncommitted data. Count preserved at ' ||
 21  				  v_count_after);
 22  	 ELSE
 23  	     DBMS_OUTPUT.PUT_LINE('[FAIL] TEST 13: Rollback state verification failed.');
 24  	 END IF;
 25  END;
 26  /
