# SmartRetail Environment Configuration
# Copy this file to .env and configure your environment variables

# MongoDB Atlas Connection URI (Replace with your Atlas credentials):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-hostname>/

# Database Names
DATABASE_NAME=smartretail_db
TEST_DATABASE_NAME=smartretail_test_db

# FastAPI Application Server Configuration
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
